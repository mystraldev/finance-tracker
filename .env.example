# Supabase — client configuration.
#
# Copy this file to `.env.local` and fill in your project values.
# Both values are PUBLIC client keys: they ship in the frontend bundle by design.
# Security is enforced by Supabase Auth + Row Level Security (RLS), not by hiding these.
#
# NEVER put the `service_role` / `sb_secret_...` key or the database password here.
#
# Find these in the Supabase dashboard:
#   Project URL  -> Settings > Data API
#   Public key   -> Settings > API Keys > "anon public" (a.k.a. sb_publishable_...)

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
